# ============================================================
#  南昌大学 课程个人作品集 - Git 忽略规则
#  作用：告诉 Git 哪些文件"不用管、不要上传"
# ============================================================

# ---------- 操作系统自动生成 ----------
.DS_Store            # macOS 桌面缓存
Thumbs.db            # Windows 缩略图缓存
Desktop.ini          # Windows 文件夹配置
ehthumbs.db

# ---------- 编辑器 / IDE 自动生成 ----------
.vscode/             # VS Code 设置
.idea/               # PyCharm / JetBrains
*.swp
*.swo
*~

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/  # Jupyter 自动存档
.pytest_cache/
.mypy_cache/
build/
dist/

# ---------- Node.js / 前端 ----------
node_modules/        # 依赖包（体积巨大，永远不上传）
dist/
.next/
.cache/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 通用构建产物 / 临时文件 ----------
*.log
*.tmp
*.bak
.cache/

# ---------- 私密信息（安全红线，绝不外传）----------
.env                 # 环境变量（含密码/密钥）
.env.*
*.key
*.pem
secrets.json

# ---------- 大文件 / 数据集 ----------
*.zip
*.rar
*.7z
*.csv
*.xlsx
*.h5
*.pkl
data/
datasets/
